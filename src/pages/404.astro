---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" label="404" noindex>
  <h2 class="section-label">[404]</h2>
  <p class="lost">This page doesn't exist, or has moved.</p>
  <p><a href="/">Back to the homepage</a></p>
</Base>

<style>
  .lost {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }
</style>
