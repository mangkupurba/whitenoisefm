---
import Base from '../layouts/Base.astro';
import HomeStrip from '../components/HomeStrip.astro';
---

<Base drafting flush>
  <h1 class="visually-hidden">WHITE NOISE FM</h1>
  <HomeStrip />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
