---
import Base from '../layouts/Base.astro';
import { ABOUT, ETYMOLOGY } from '../data/site';
---

<Base title="Concept" label="Concept">
  <section class="block-section" id="about">
    <h2 class="section-label">[About]</h2>
    <div class="about">
      {ABOUT.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="block-section" id="etymology">
    <h2 class="section-label">[Etymology]</h2>
    <dl class="etymology">
      {
        ETYMOLOGY.map((row) => (
          <div class="row">
            <dt class="caps">{row.term}</dt>
            <dd class="def">{row.definition}</dd>
            <dd class="result caps">{row.result}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block-section" id="tools">
    <h2 class="section-label">[Tools] <span class="sub">(Values)</span></h2>
    <p class="pending caps">Forthcoming</p>
  </section>
</Base>

<style>
  .block-section {
    max-width: 50rem;
    margin-bottom: 3.2rem;
  }
  .about p {
    margin: 0 0 0.8rem;
  }
  .about p:first-child {
    font-size: 1.05rem;
    line-height: 1;
  }
  .etymology {
    margin: 0;
    display: grid;
    gap: 2.4rem;
  }
  /* Each term carries the same bracket as the nav tabs: a tick, a drop down
     the left, and a diagonal closing back up toward the term. */
  .row {
    --line: 1.25px;
    position: relative;
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.4rem 2rem;
    padding: 0 0 0 1.1rem;
  }
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0.56rem;
    height: 2.5rem;
    border-top: var(--line) solid var(--yellow);
    border-left: var(--line) solid var(--yellow);
    pointer-events: none;
  }
  .row::after {
    content: '';
    position: absolute;
    top: 2.5rem;
    left: 0;
    width: 1.3rem;
    height: var(--line);
    background: var(--yellow);
    transform: rotate(-36deg);
    transform-origin: 0 50%;
    pointer-events: none;
  }
  .row dt {
    grid-row: span 2;
    font-size: var(--display-size);
    color: var(--yellow-text);
  }
  .row dd {
    margin: 0;
  }
  .result {
    font-size: var(--display-size);
    color: var(--ink);
    border-left: 2px solid var(--red);
    padding-left: 0.7rem;
    letter-spacing: var(--display-tracking);
  }
  .sub {
    color: var(--label-ink);
    opacity: 0.7;
  }
  .pending {
    margin: 0;
    font-size: var(--display-size);
    color: var(--ink-dim);
  }
  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
    }
    /* shorter bracket so it closes before the description below the term */
    .row::before {
      height: 1.9rem;
    }
    .row::after {
      top: 1.9rem;
      width: 0.9rem;
    }
    .row dt {
      grid-row: auto;
    }
  }
</style>
