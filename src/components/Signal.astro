---
// A drafted signal line: white noise on the left resolving into an FM wave on the right.
// Generated at build time, so it is a static SVG with no script.

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1000;
const H = 260;
const MID = H / 2;
const rand = mulberry32(2020);
const smooth = (a: number, b: number, x: number) => {
  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
  return t * t * (3 - 2 * t);
};

const points: string[] = [];
for (let x = 0; x <= W; x += 2) {
  const n = (rand() - 0.5) * 2;
  const noise = n * 78 * smooth(0, 120, x);
  const t = x / W;
  const fm = Math.sin(2 * Math.PI * 22 * t + 6 * Math.sin(2 * Math.PI * 1.6 * t)) * 72;
  const mix = smooth(330, 520, x);
  const fade = 1 - smooth(940, 1000, x);
  const y = MID + (noise * (1 - mix) + fm * mix) * fade;
  points.push(`${x},${y.toFixed(1)}`);
}
interface Props {
  /** Wave only, without the WHITE NOISE = FM caption */
  bare?: boolean;
}
const { bare = false } = Astro.props;
const ticks = Array.from({ length: 21 }, (_, i) => i * 50);
---

<figure class="signal" aria-label="White noise resolving into a frequency-modulated wave">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img">
    <line x1="0" y1={MID} x2={W} y2={MID} class="axis"></line>
    {ticks.map((x) => <line x1={x} y1={MID - 4} x2={x} y2={MID + 4} class="tick" />)}
    <polyline points={points.join(' ')} class="wave"></polyline>
  </svg>
  {
    !bare && (
      <figcaption class="caption caps">
        <span>White Noise</span>
        <span class="eq">=</span>
        <span>FM</span>
      </figcaption>
    )
  }
</figure>

<style>
  .signal {
    margin: 0;
    width: 100%;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .axis {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .tick {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .wave {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    margin-top: 1.4rem;
    font-size: var(--display-size);
    color: var(--yellow-text);
  }
  .eq {
    color: var(--red);
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: 0;
  }
</style>
