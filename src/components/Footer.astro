  </a>
  <dl class="contact">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
    </div>
    <div>
      <dt>Instagram</dt>
      <dd>
        <a href={`https://www.instagram.com/${CONTACT.instagram}`} target="_blank" rel="noopener"
          >@{CONTACT.instagram}</a
        >
      </dd>
    </div>
  </dl>
  <p class="legal">
    ©{year} White Noise FM. All Rights Reserved.<br />
    All contents of this website are the property of White Noise FM. No part of this site,
    including all text and images, may be reproduced in any form without the prior written consent
    of White Noise FM.
  </p>
</footer>

<style>
  .footer {
    padding: 1rem 0.7rem 1.2rem 1.4rem;
    border-top: 1px solid var(--line);
    display: grid;
    /* logo and contact side by side, the legal line underneath */
    grid-template-columns: auto 1fr;
    gap: 1rem 3rem;
    align-items: center;
    font-size: 0.86rem;
  }
  .logo {
    display: block;
    color: var(--ink);
    line-height: 0;
  }
  .logo:hover {
    color: var(--yellow-text);
  }
  .logo svg {
    display: block;
    width: auto;
    height: 1.95rem;
  }
  .contact {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .contact div {
    display: grid;
    grid-template-columns: 7.5rem auto;
  }
  .contact dt {
    color: var(--ink-dim);
  }
  .contact dt::after {
    content: ':';
    float: right;
    margin-right: 1rem;
  }
  .contact dd {
    margin: 0;
  }
  .contact a {
    text-decoration: none;
  }
  .legal {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 46rem;
    color: var(--ink-dim);
    line-height: 1;
  }
  @media (max-width: 820px) {
    .footer {
      gap: 0.3rem 0.7rem;
      padding: 0.35rem 0.7rem 0.45rem;
      font-size: 8.5px;
    }
    .logo svg {
      height: 0.82rem;
    }
    .contact {
      gap: 0;
    }
    .contact div {
      grid-template-columns: 3.4rem auto;
    }
    .contact dt::after {
      margin-right: 0.5rem;
    }
  }
</style>
